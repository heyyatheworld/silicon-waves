# Copy to .env and fill in real values. Never commit .env.

# --- AzuraCast (required) ---
AZURA_API_KEY=
BASE_URL=https://your-radio.example.com/api
STATION_ID=1

# --- OpenAI (required) ---
OPENAI_API_KEY=

# --- ElevenLabs (required) ---
ELEVENLABS_API_KEY=
VOICE_ID=

# --- Optional (defaults shown in README) ---
# REMOTE_DIR=ai_voiceovers
# POLL_INTERVAL_SEC=15
# SEGMENT_REM_MIN=40
# SEGMENT_REM_MAX=70
# UPLOAD_INDEX_WAIT_SEC=5
# POST_SEGMENT_SLEEP_SEC=70
# OPENAI_MODEL=gpt-4o-mini
# ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
# REQUEST_TIMEOUT_SEC=30
# LOG_LEVEL=INFO
# HTTP_RETRY_MAX=3
# HTTP_RETRY_BACKOFF_SEC=1.0
# SCRIPT_MAX_CHARS=1200
